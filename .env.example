# Queuti — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/queuti

# Upstash Redis REST URL (optional — enables caching; app falls back without it)
UPSTASH_REDIS_URL=https://us1-xxxx.upstash.io

# JWT signing secret (optional in dev — defaults to dev-insecure-secret)
AUTH_SECRET=change-me-to-a-long-random-string