# Queuti — environment template
# Copy to .env.local and fill in real values. NEVER commit .env.local.

# MongoDB Atlas connection string (required)
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/queuti

# Upstash Redis REST URL (optional — enables caching; app falls back without it)
UPSTASH_REDIS_URL=https://us1-xxxx.upstash.io

# JWT signing secret (optional in dev — defaults to dev-insecure-secret)
AUTH_SECRET=change-me-to-a-long-random-string

# --- Password-reset email (optional in dev) ---
# If unset, reset emails are logged to the server console (dev/staging builds
# also echo the reset link in the forgot-password API response).
# --- Transactional email (Resend API) ---
# API key from https://resend.com/api-keys
# Emails send from onboarding@resend.dev (sandbox) by default.
# To use your own domain, verify it at resend.com/domains and set RESEND_FROM.
RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM=Queuti <no-reply@queuti.com>

# --- Legacy SMTP (optional override) ---
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Queuti <no-reply@queuti.com>

# --- Error logging (#40) ---
# Optional webhook (Discord/Slack/ntfy) that receives a JSON POST when the
# middleware or lib/logging reports an error. Omit to disable webhook delivery
# (errors still go to the server console as structured JSON lines).
# ERROR_WEBHOOK_URL=https://hooks.slack.com/services/....